{
  "$id": "urn:dlcl:schema:manifest:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "role": {
            "enum": [
              "claim-registry",
              "documentation",
              "fixture",
              "formal-proof",
              "integrity-schema",
              "manuscript",
              "metadata",
              "provenance",
              "receipt",
              "source",
              "tool",
              "other"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "id",
          "path",
          "media_type",
          "bytes",
          "sha256",
          "role"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "claim_registry": {
      "const": "integrity/claims.json"
    },
    "evidence_sets": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "independent_reproduction": {
                  "const": true
                }
              },
              "required": [
                "independent_reproduction"
              ]
            },
            "then": {
              "properties": {
                "external_evidence_artifacts": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "properties": {
          "commands": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "external_evidence_artifacts": {
            "items": {
              "$ref": "#/$defs/stableId"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "independent_reproduction": {
            "type": "boolean"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "negative_controls": {
            "items": {
              "$ref": "#/$defs/stableId"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "producer": {
            "minLength": 1,
            "type": "string"
          },
          "receipt_artifacts": {
            "items": {
              "$ref": "#/$defs/stableId"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "script_artifact": {
            "$ref": "#/$defs/stableId"
          }
        },
        "required": [
          "id",
          "label",
          "producer",
          "independent_reproduction",
          "external_evidence_artifacts",
          "script_artifact",
          "receipt_artifacts",
          "commands",
          "negative_controls"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "excluded_assurances": {
      "items": {
        "enum": [
          "absolute novelty",
          "independent reproduction",
          "peer review",
          "publication"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "formalisation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "axiom_audit_receipt": {
                "$ref": "#/$defs/stableId"
              },
              "build_receipt": {
                "$ref": "#/$defs/stableId"
              },
              "lean_toolchain_artifact": {
                "$ref": "#/$defs/stableId"
              }
            }
          }
        }
      ],
      "properties": {
        "axiom_audit_receipt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stableId"
            }
          ]
        },
        "build_receipt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stableId"
            }
          ]
        },
        "lean_toolchain_artifact": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stableId"
            }
          ]
        },
        "mathlib_commit": {
          "const": "1f0fbd1ad9ff6e4751ab4564fc70cc4f2a1fadf9"
        },
        "status": {
          "enum": [
            "planned",
            "partial",
            "complete"
          ]
        }
      },
      "required": [
        "status",
        "lean_toolchain_artifact",
        "mathlib_commit",
        "build_receipt",
        "axiom_audit_receipt"
      ],
      "type": "object"
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "license": {
          "minLength": 1,
          "type": "string"
        },
        "slug": {
          "const": "determinant-lines-character-lattices"
        },
        "status": {
          "enum": [
            "research-draft",
            "candidate",
            "released"
          ]
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "slug",
        "version",
        "status",
        "authors",
        "license"
      ],
      "type": "object"
    },
    "parent": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "const": "217f17d9f73e8b5a1bdb8d114bb1003dbed146bc"
        },
        "doi": {
          "const": "10.5281/zenodo.21855302"
        },
        "git_tag": {
          "const": "v0.3-candidate"
        },
        "tag_object": {
          "const": "6f400c15d9203f8ef6eb617a8c64a5dac66cd442"
        }
      },
      "required": [
        "doi",
        "git_tag",
        "tag_object",
        "commit"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "package",
    "parent",
    "artifacts",
    "evidence_sets",
    "formalisation",
    "claim_registry",
    "excluded_assurances"
  ],
  "type": "object",
  "$defs": {
    "relativePath": {
      "allOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "not": {
            "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$)|.*\\\\)"
          }
        }
      ]
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "stableId": {
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    }
  }
}

