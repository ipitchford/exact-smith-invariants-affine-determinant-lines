+
+\[
+ \boxed{
+ h(\mathbf e)=2^{\eta_2(\mathbf e)}
+ \prod_{1\le a<b\le k}Q_{ab}^{\mathrm{odd}}.
+ }
+\tag{7.8}
+\]
